<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Were you bruxing?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"
            android:textColor="?attr/colorPrimary"/>

        <!-- Section 1: Data Quality -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Summary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:textColor="?attr/colorPrimary"/>

                <TextView
                    android:id="@+id/text_responses_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Responses: 0/0 (0%)"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/text_response_rates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Response rate with tone: 0%\nResponse rate without tone: 0%"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    android:textColor="?attr/colorOnSurfaceVariant"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/text_with_beep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="With Beep:\nYes: 0, No: 0, Ignored: 0, Unanswered: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/text_without_beep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Without Beep:\nYes: 0, No: 0, Ignored: 0, Unanswered: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/text_avg_delay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Average response delay: 0s"
                    android:textStyle="italic"
                    android:textSize="14sp"
                    android:textColor="?attr/colorSecondary"/>

                <TextView
                    android:id="@+id/experimental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This is an experimental feature and it may be unreliable"
                    android:textStyle="italic"
                    android:textSize="14sp"
                    android:textColor="?attr/colorSecondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Timeline -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timeline"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorPrimary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Response Rates per Day" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_timeline_response_rates"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                    app:strokeWidth="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

               <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="% Yes per Day" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_timeline_yes"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

               <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="% No per Day" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_timeline_no"
                    android:layout_width="match_parent"
                    android:layout_height="250dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: Hourly Distribution -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Distribution"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorPrimary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Average Yes Responses (8:00 - 19:00)" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_hourly_yes_all"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yes Responses with Tone" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_hourly_yes_tone"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Yes Responses without Tone" android:textAlignment="center" android:textSize="14sp" android:layout_marginBottom="8dp" android:textColor="?attr/colorOnSurface"/>
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chart_hourly_yes_notone"
                    android:layout_width="match_parent"
                    android:layout_height="300dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
