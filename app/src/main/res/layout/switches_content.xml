<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    android:id="@+id/switches_tags_holder">

    <!-- ChipGroup per MainActivity (Compatto, orizzontale) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="4dp"
        app:singleSelection="false"
        android:visibility="gone" />

    <!-- Switches in two columns (Mantenuto intatto per SwitchEditor) -->
    <LinearLayout
        android:id="@+id/switches_columns_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:animateLayoutChanges="true">

        <!-- Left Column -->
        <LinearLayout
            android:id="@+id/left_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:orientation="vertical">
        </LinearLayout>

        <!-- Right Column -->
        <LinearLayout
            android:id="@+id/right_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:animateLayoutChanges="true"
            android:orientation="vertical">
        </LinearLayout>
    </LinearLayout>
</LinearLayout>