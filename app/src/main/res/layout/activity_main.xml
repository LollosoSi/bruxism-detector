<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:animateLayoutChanges="true"
    tools:context=".MainActivity"
    >

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:fillViewport="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/menu_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compile this before starting the service"
                android:textAlignment="center"
                android:textSize="20sp"
                android:typeface="monospace" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="25dp" />

            <include layout="@layout/moodseekbar" />

            <Space
                android:layout_width="wrap_content"
                android:layout_height="15dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <include layout="@layout/switches_content" />

            </ScrollView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sessioncard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="@dimen/cardview_default_elevation">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/session_card_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_horizontal"
                android:padding="8dp">

                <!-- Only show in editor with "tools" namespace -->
                <ImageView
                    android:id="@+id/wifi_signal_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="WiFi RSSI"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/session_settings_textview_handle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/session_settings_textview_handle"
                    app:srcCompat="@drawable/wifi_boh"
                    app:tint="@color/material_dynamic_primary70"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/update_clickme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Update available, click to download"
                    android:textAlignment="center"
                    android:textColor="@color/material_green_500"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/updatedtextnotification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Hooray!\nLooks like your Arduino is up to date!"
                    android:textAlignment="center"
                    android:textColor="@color/material_green_500"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/update_clickme" />

                <TextView
                    android:id="@+id/session_settings_textview_handle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Session settings"
                    android:textAlignment="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/updatedtextnotification" />

                <LinearLayout
                    android:id="@+id/left_column_switches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    app:layout_constraintEnd_toStartOf="@id/right_column_switches"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/session_settings_textview_handle">

                    <include
                        android:id="@+id/switch_sharedpref"
                        layout="@layout/switch_row" />

                    <include
                        android:id="@+id/switch_sharedpref_use_threshold"
                        layout="@layout/switch_row" />


                    <!-- Multi-state Beep Row (3 stati) -->
                    <LinearLayout
                        android:id="@+id/row_multistate_beep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <!-- Multi-state Beep Row (3 stati) -->
                        <SeekBar
                            android:id="@+id/switch_beep_multistate"
                            android:layout_width="56dp"
                            android:layout_height="32dp"
                            android:max="2"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:progress="1"
                            android:progressDrawable="@drawable/m3_switch_multistate_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/m3_switch_multistate_thumb"
                            android:thumbOffset="10dp"
                            android:tickMark="@drawable/m3_switch_tickmark" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/beep_multistate_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Beeps"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/beep_multistate_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disabled"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>


                    <!-- Multi-state Alarm Row (4 stati) -->
                    <LinearLayout
                        android:id="@+id/row_multistate_alarm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <!-- Multi-state Alarm Row (4 stati) -->
                        <SeekBar
                            android:id="@+id/switch_alarm_multistate"
                            android:layout_width="72dp"
                            android:layout_height="32dp"
                            android:max="3"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/m3_switch_multistate_track"
                            android:splitTrack="false"
                            android:thumb="@drawable/m3_switch_multistate_thumb"
                            android:thumbOffset="10dp"
                            android:tickMark="@drawable/m3_switch_tickmark" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/alarm_multistate_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alarm"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/alarm_multistate_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disabled"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/right_column_switches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingEnd="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/left_column_switches"
                    app:layout_constraintTop_toTopOf="@id/left_column_switches">

                    <include
                        android:id="@+id/switch_autostart_listener"
                        layout="@layout/switch_row" />


                    <!-- Riga 3 Icone Sensori (Microfono, Movimento, Fotocamera) senza bordo né tick -->
                    <LinearLayout
                        android:id="@+id/sensor_icons_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sensor_noise"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:checkable="true"
                            android:contentDescription="Record noise"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/mic"
                            app:iconGravity="textTop"
                            app:iconPadding="0dp"
                            app:iconSize="26dp"
                            app:iconTint="@color/icon_toggle_tint"
                            app:rippleColor="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sensor_accel"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:checkable="true"
                            android:contentDescription="Record movement"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/accel"
                            app:iconGravity="textTop"
                            app:iconPadding="0dp"
                            app:iconSize="26dp"
                            app:iconTint="@color/icon_toggle_tint"
                            app:rippleColor="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sensor_camera"
                            style="?attr/borderlessButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:checkable="true"
                            android:contentDescription="Record camera"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:icon="@drawable/camera"
                            app:iconGravity="textTop"
                            app:iconPadding="0dp"
                            app:iconSize="26dp"
                            app:iconTint="@color/icon_toggle_tint"
                            app:rippleColor="@android:color/transparent" />

                    </LinearLayout>

                    <!-- Sotto-opzioni Camera: Icona a sinistra che si accende + Testo a destra -->
                    <LinearLayout
                        android:id="@+id/camera_suboptions_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Only on alarms -->
                        <LinearLayout
                            android:id="@+id/btn_camera_only_alarms_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_camera_only_alarms"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:checkable="true"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:icon="@drawable/alarms"
                                app:iconGravity="textTop"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                app:iconTint="@color/icon_toggle_tint"
                                app:rippleColor="@android:color/transparent" />

                            <TextView
                                android:id="@+id/camera_only_alarms_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Only on alarms"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Flash / Torch -->
                        <LinearLayout
                            android:id="@+id/btn_camera_torch_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_camera_torch_icon"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:checkable="true"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:icon="@drawable/torch"
                                app:iconGravity="textTop"
                                app:iconPadding="0dp"
                                app:iconSize="20dp"
                                app:iconTint="@color/icon_toggle_tint"
                                app:rippleColor="@android:color/transparent" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/camera_torch_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Flash"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/camera_torch_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hold to tune brightness"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>


                    <include
                        android:id="@+id/switch_tcp"
                        layout="@layout/switch_row"
                        android:visibility="gone" />

                </LinearLayout>

                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/switches_bottom_barrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="left_column_switches,right_column_switches" />

                <!-- ========================================================= -->
                <!-- RIGA 1: START (Filled Button, compatto ma visibile)       -->
                <!-- ========================================================= -->
                <Button
                    android:id="@+id/button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:onClick="startService"
                    android:text="Start"
                    android:textSize="14sp"
                    app:icon="@drawable/play"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/switches_bottom_barrier" />


                <!-- ========================================================= -->
                <!-- RIGA 2: SUMMARY, CALENDAR, GRAPHS                         -->
                <!-- ========================================================= -->
                <Button
                    android:id="@+id/button_makecharts"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="launchChartActivity"
                    android:paddingHorizontal="6dp"
                    android:text="Summary"
                    android:textSize="12sp"
                    app:icon="@drawable/summary"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_calendar"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/button" />

                <Button
                    android:id="@+id/button_calendar"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="startCalendar"
                    android:paddingHorizontal="6dp"
                    android:text="Calendar"
                    android:textSize="12sp"
                    app:icon="@drawable/calendar_icon"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_makegraphs"
                    app:layout_constraintStart_toEndOf="@id/button_makecharts"
                    app:layout_constraintTop_toTopOf="@id/button_makecharts" />

                <Button
                    android:id="@+id/button_makegraphs"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="tryGraphing"
                    android:paddingHorizontal="6dp"
                    android:text="Graphs"
                    android:textSize="12sp"
                    app:icon="@drawable/graphs_icon"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_calendar"
                    app:layout_constraintTop_toTopOf="@id/button_makecharts" />

                <!-- ========================================================= -->
                <!-- RIGA 3: STATS, SMARTBAND, TAGS                            -->
                <!-- ========================================================= -->
                <Button
                    android:id="@+id/button_trainer_stats"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="launchTrainerStats"
                    android:paddingHorizontal="6dp"
                    android:text="Trainer Stats"
                    android:textSize="12sp"
                    app:icon="@drawable/analytics"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_extractdb"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/button_makecharts" />

                <Button
                    android:id="@+id/button_extractdb"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="openFilePicker"
                    android:paddingHorizontal="6dp"
                    android:text="Smartband"
                    android:textSize="12sp"
                    app:icon="@drawable/tbconvert"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_tageditor"
                    app:layout_constraintStart_toEndOf="@id/button_trainer_stats"
                    app:layout_constraintTop_toTopOf="@id/button_trainer_stats" />

                <Button
                    android:id="@+id/button_tageditor"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="LaunchSwitchEditor"
                    android:paddingHorizontal="6dp"
                    android:text="Tags"
                    android:textSize="12sp"
                    app:icon="@drawable/tagging"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_extractdb"
                    app:layout_constraintTop_toTopOf="@id/button_trainer_stats" />

                <!-- ========================================================= -->
                <!-- RIGA 4: PC, SET WIFI, TRAINER                             -->
                <!-- ========================================================= -->
                <Button
                    android:id="@+id/data_sharing"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="launchDataSharingActivity"
                    android:paddingHorizontal="6dp"
                    android:text="Cloud Sync"
                    android:textSize="12sp"
                    app:icon="@drawable/cloud"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_sendwifi"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/button_trainer_stats" />

                <Button
                    android:id="@+id/button_sendwifi"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="updateWifiViaNetwork"
                    android:paddingHorizontal="6dp"
                    android:text="Set WiFi"
                    android:textSize="12sp"
                    app:icon="@drawable/wifi_icon"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toStartOf="@id/button_start_trainer"
                    app:layout_constraintStart_toEndOf="@id/data_sharing"
                    app:layout_constraintTop_toTopOf="@id/data_sharing" />

                <!-- Visibilità gestita a codice (compare se autostart è disabilitato) -->
                <Button
                    android:id="@+id/button_start_trainer"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:onClick="startTrainer"
                    android:paddingHorizontal="6dp"
                    android:text="Trainer"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:icon="@drawable/trainer"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/button_sendwifi"
                    app:layout_constraintTop_toTopOf="@id/data_sharing" />

                <!-- ========================================================= -->
                <!-- TASTI EVENTUALI NASCOSTI (Default GONE, agganciati in fondo) -->
                <!-- ========================================================= -->
                <Button
                    android:id="@+id/button_test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:onClick="launchcameratest"
                    android:text="Camera test"
                    android:visibility="gone"
                    app:icon="@drawable/trainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/data_sharing" />

                <Button
                    android:id="@+id/button_startcatcher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:onClick="scheduleUDPCatcher"
                    android:text="Schedule UDPCatcher"
                    android:visibility="gone"
                    app:icon="@drawable/start_recording"
                    app:layout_constraintStart_toEndOf="@id/button_test"
                    app:layout_constraintTop_toBottomOf="@id/data_sharing" />

                <Button
                    android:id="@+id/firmware"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:onClick="startota"
                    android:text="OTA"
                    android:visibility="gone"
                    app:icon="@drawable/start_recording"
                    app:layout_constraintStart_toEndOf="@id/button_startcatcher"
                    app:layout_constraintTop_toBottomOf="@id/data_sharing" />



            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/reception_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:animateLayoutChanges="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="gone">


        <TextView
            android:id="@+id/titleinfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We are receiving data\nDo you want to set a threshold?"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/infotext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classification data:"
            android:textAlignment="center" />

        <Space
            android:layout_width="wrap_content"
            android:layout_height="10dp" />

        <SeekBar
            android:id="@+id/reception"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/custom_seekbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="fill_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mintext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="min"
                android:textAlignment="viewStart" />

            <TextView
                android:id="@+id/curval_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="value"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/maxtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="max"
                android:textAlignment="viewEnd" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="30dp" />

        <Button
            android:id="@+id/button_awesome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="hideReception"
            android:text="Awesome!" />

        <androidx.cardview.widget.CardView
            android:id="@+id/fft_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:animateLayoutChanges="true"
            android:elevation="4dp"
            android:visibility="visible"
            app:cardCornerRadius="12dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/fft_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="Listening for FFT parameters..."
                    android:textAlignment="center" />

                <LinearLayout
                    android:id="@+id/recording_holder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Button
                        android:id="@+id/button_start_over"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="Delete old recordings"
                        android:textAllCaps="false"
                        android:textSize="14sp" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/hold_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="0.5"
                            android:text="Hold to record:"
                            android:textAppearance="?attr/textAppearanceBodyMedium" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <Button
                                android:id="@+id/button_non_clenching"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="Non-Clenching"
                                android:textAllCaps="false"
                                android:textSize="14sp" />

                            <Button
                                android:id="@+id/button_clenching"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Clenching"
                                android:textAllCaps="false"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/button_calculate_weights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="Calculate weights"
                            android:textAllCaps="false"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/share_training_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="Donate Data"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <ProgressBar
                        android:id="@+id/weights_progress_bar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <EditText
                        android:id="@+id/weights_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="top"
                        android:hint="Weights will appear here"
                        android:inputType="textMultiLine"
                        android:maxLines="6"
                        android:minLines="3"
                        android:padding="8dp"
                        android:scrollbars="vertical"
                        android:visibility="gone" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/fft_chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:minHeight="200dp"
                        tools:visibility="visible" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>